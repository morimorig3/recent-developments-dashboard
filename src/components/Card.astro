---
import HeartIcon from '../assets/heart.svg';
import type { ICard } from '../types';
import { getSummaryFromUrl } from '../services/getSummaryFromUrl';
interface Props extends ICard {}
const { title, name, url, createdAt, likesCount, site } = Astro.props;
const summary = await getSummaryFromUrl(url);
---

<div
  class="block bg-white dark:bg-gray-800 rounded-md shadow-sm hover:shadow-md dark:shadow-gray-700/30 dark:hover:shadow-gray-700/50 transition-all duration-200 border border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:border-gray-200 dark:hover:border-gray-600 relative"
>
  <!-- 記事リンク部分 -->
  <a
    href={url}
    data-url={url}
    target="_blank"
    rel="noopener noreferrer"
    class="block p-4 border-b border-gray-100 dark:border-gray-700"
  >
    <div class="flex justify-between">
      <h2
        class="text-base font-bold text-gray-800 dark:text-gray-100 mb-1 line-clamp-1 group-hover:text-gray-900 dark:group-hover:text-white transition-colors"
      >
        {title}
      </h2>
      <div class="flex items-center gap-2">
        <p
          class="text-xs text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors"
        >
          {site}
        </p>
        <div
          id="new-icon"
          class="w-8 h-8 bg-red-500 dark:bg-red-400 text-white text-xs hidden rounded-full grid place-content-center absolute -top-3 -left-3"
        >
          new
        </div>
      </div>
    </div>
    <p
      class="text-xs text-gray-600 dark:text-gray-400 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors"
    >
      @{name}
    </p>
    <div
      class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors"
    >
      <p>{createdAt}</p>
      <p class="flex items-center gap-1">
        <HeartIcon
          width={16}
          height={16}
          class="text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors"
        />
        {likesCount}
      </p>
    </div>
  </a>

  <!-- 要約部分 -->
  <div>
    <div id="summary-content" class="overflow-hidden transition-all duration-200 max-h-0 opacity-0">
      <div class="px-4 py-3">
        <div class="space-y-4">
          {
            summary.map(({ title, body }) => (
              <div class="p-4 bg-gray-50/50 dark:bg-gray-700/30 rounded-md border border-gray-100 dark:border-gray-700">
                <h3 class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-2">{title}</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <button
      id="summary-toggle"
      class="w-full py-2.5 px-4 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-all duration-200 flex items-center justify-between cursor-pointer border-t border-gray-100 dark:border-gray-700"
    >
      <span>要約を見る</span>
      <svg
        id="summary-icon"
        class="w-4 h-4 transition-transform duration-200"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </button>
  </div>
</div>

<script>
  import { saveReadArticle, isArticleRead } from '../utils/localStorage';

  // 既読状態の確認と表示
  document.querySelectorAll('[data-url]').forEach((card) => {
    const url = card.getAttribute('data-url');
    if (!url) return;

    const newIcon = card.querySelector('#new-icon');
    if (newIcon) {
      newIcon.classList.toggle('hidden', isArticleRead(url));
    }
  });

  // 要約表示の切り替え
  document.querySelectorAll('#summary-toggle').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const summaryContent = button.parentElement?.querySelector('#summary-content');
      const summaryIcon = button.querySelector('#summary-icon');
      if (summaryContent) {
        const isHidden = summaryContent.classList.contains('max-h-0');
        const buttonText = button.querySelector('span');

        // アニメーション用のクラスを切り替え
        if (isHidden) {
          summaryContent.classList.remove('max-h-0', 'opacity-0');
          summaryContent.classList.add('max-h-[1000px]', 'opacity-100');
        } else {
          summaryContent.classList.remove('max-h-[1000px]', 'opacity-100');
          summaryContent.classList.add('max-h-0', 'opacity-0');
        }

        if (buttonText) {
          buttonText.textContent = isHidden ? '要約を隠す' : '要約を見る';
        }
        if (summaryIcon) {
          summaryIcon.classList.toggle('rotate-180', !isHidden);
        }
      }
    });
  });

  // カードクリック時の処理
  document.querySelectorAll('[data-url]').forEach((card) => {
    card.addEventListener('click', (event) => {
      const url = card.getAttribute('data-url');
      if (!url) return;

      // 要約ボタンがクリックされた場合は記事を開かない
      if ((event.target as HTMLElement).closest('#summary-toggle')) {
        return;
      }

      saveReadArticle(url);

      // クリック後にカードの見た目を更新
      const newIcon = card.querySelector('#new-icon');
      if (newIcon) {
        newIcon.classList.add('hidden');
      }

      window.open(url, '_blank');
    });
  });
</script>
