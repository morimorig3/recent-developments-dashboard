---
import type { ICard } from '../types';
interface Props extends ICard {}
const { title, name, url, createdAt, likesCount, site } = Astro.props;
import HeartIcon from '../assets/heart.svg';
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="block p-4 bg-white dark:bg-gray-800 rounded-md shadow-sm hover:shadow-md dark:shadow-gray-700/30 dark:hover:shadow-gray-700/50 transition-all duration-200 border border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:border-gray-200 dark:hover:border-gray-600 relative"
  data-url={url}
>
  <div class="flex justify-between">
    <h2
      class="text-base font-bold text-gray-800 dark:text-gray-100 mb-1 line-clamp-1 group-hover:text-gray-900 dark:group-hover:text-white transition-colors"
    >
      {title}
    </h2>
    <div class="flex items-center gap-2">
      <p
        class="text-xs text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors"
      >
        {site}
      </p>
      <div
        id="new-icon"
        class="w-8 h-8 bg-red-500 dark:bg-red-400 text-white text-xs hidden rounded-full grid place-content-center absolute -top-3 -left-3"
      >
        new
      </div>
    </div>
  </div>
  <p
    class="text-xs text-gray-600 dark:text-gray-400 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors"
  >
    @{name}
  </p>
  <div
    class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors"
  >
    <p>{createdAt}</p>
    <p class="flex items-center gap-1">
      <HeartIcon
        width={16}
        height={16}
        class="text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors"
      />
      {likesCount}
    </p>
  </div>
</a>

<script>
  import { saveReadArticle, isArticleRead } from '../utils/localStorage';

  // 既読状態の確認と表示
  document.querySelectorAll('a[data-url]').forEach((link) => {
    const url = link.getAttribute('data-url');
    if (!url) return;

    const newIcon = link.querySelector('#new-icon');
    if (newIcon) {
      newIcon.classList.toggle('hidden', isArticleRead(url));
    }
  });

  // クリック時の処理
  document.querySelectorAll('a[data-url]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const url = link.getAttribute('data-url');
      if (!url) return;

      event.preventDefault();
      saveReadArticle(url);

      // クリック後にカードの見た目を更新
      const newIcon = link.querySelector('#new-icon');
      if (newIcon) {
        newIcon.classList.add('hidden');
      }

      window.open(url, '_blank');
    });
  });
</script>
