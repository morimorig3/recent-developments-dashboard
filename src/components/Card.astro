---
import HeartIcon from '../assets/heart.svg';
import type { ICard } from '../types';
import { getSourceLabel } from '../config/primarySources';
interface Props extends Omit<ICard, 'createdAtRaw' | 'filterKey'> {}
const { title, name, url, createdAt, likesCount, site, category } = Astro.props;

// 公式情報はソースIDではなく表示名(例: web.dev, V8 Blog)を出す
const siteLabel = getSourceLabel(site);
// RSS/Atomにいいね相当の値が無いため公式情報では非表示にする
const showLikes = category === 'curated';
// 公式情報は媒体ごとにセクション分けして見出しに媒体名を出しているため、カード側では重複表示しない
const showSiteLabel = category === 'curated';
---

<div
  class="block bg-white dark:bg-gray-800 rounded-md shadow-sm hover:shadow-md dark:shadow-gray-700/30 dark:hover:shadow-gray-700/50 transition-all duration-200 border border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 hover:border-gray-200 dark:hover:border-gray-600 relative"
>
  <!-- 記事リンク部分 -->
  <a
    href={url}
    data-url={url}
    target="_blank"
    rel="noopener noreferrer"
    class="block p-4 border-b border-gray-100 dark:border-gray-700"
  >
    <div class="flex justify-between items-start gap-2">
      <h2
        class="text-base font-bold text-gray-800 dark:text-gray-100 mb-1 line-clamp-1 group-hover:text-gray-900 dark:group-hover:text-white transition-colors flex-1"
      >
        {title}
      </h2>
      <div class="flex items-center gap-2 shrink-0">
        <button
          data-bookmark-btn
          data-bookmark-url={url}
          data-bookmark-title={title}
          class="p-1 text-gray-400 hover:text-yellow-500 dark:text-gray-500 dark:hover:text-yellow-400 transition-colors cursor-pointer"
          aria-label="ブックマーク"
        >
          <svg
            class="w-5 h-5 bookmark-icon-empty"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
            ></path>
          </svg>
          <svg
            class="w-5 h-5 bookmark-icon-filled hidden text-yellow-500 dark:text-yellow-400"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
        {
          showSiteLabel && (
            <p class="text-xs text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors">
              {siteLabel}
            </p>
          )
        }
        <div
          id="new-icon"
          class="w-8 h-8 bg-red-500 dark:bg-red-400 text-white text-xs hidden rounded-full grid place-content-center absolute -top-3 -left-3"
        >
          new
        </div>
      </div>
    </div>
    {
      name && (
        <p class="text-sm text-gray-600 dark:text-gray-400 group-hover:text-gray-700 dark:group-hover:text-gray-300 transition-colors">
          @{name}
        </p>
      )
    }
    <div
      class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors"
    >
      <p>{createdAt}</p>
      {
        showLikes && (
          <p class="flex items-center gap-1">
            <HeartIcon
              width={16}
              height={16}
              class="text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors"
            />
            {likesCount}
          </p>
        )
      }
    </div>
  </a>
</div>

<script>
  import {
    saveReadArticle,
    isArticleRead,
    isBookmarked,
    toggleBookmark,
  } from '../utils/localStorage';

  // ブックマークボタンの状態を更新
  function updateBookmarkButton(button: Element, bookmarked: boolean) {
    const emptyIcon = button.querySelector('.bookmark-icon-empty');
    const filledIcon = button.querySelector('.bookmark-icon-filled');
    if (emptyIcon && filledIcon) {
      emptyIcon.classList.toggle('hidden', bookmarked);
      filledIcon.classList.toggle('hidden', !bookmarked);
    }
  }

  // ブックマーク状態の初期化
  document.querySelectorAll<HTMLButtonElement>('[data-bookmark-btn]').forEach((button) => {
    const url = button.dataset.bookmarkUrl;
    if (!url) return;

    // 初期状態を設定
    updateBookmarkButton(button, isBookmarked(url));

    // クリックイベント
    button.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();

      const title = button.dataset.bookmarkTitle || '';
      const newState = toggleBookmark(url, title);
      updateBookmarkButton(button, newState);

      // ブックマーク変更イベントを発火
      window.dispatchEvent(
        new CustomEvent('bookmark-changed', { detail: { url, bookmarked: newState } }),
      );
    });
  });

  // モーダルからのブックマーク解除を反映
  window.addEventListener('bookmark-changed', (event) => {
    const detail = (event as CustomEvent).detail;
    if (!detail?.url) return;

    // CSS.escape()でURLをエスケープしてセレクタインジェクションを防止
    const button = document.querySelector(`[data-bookmark-url="${CSS.escape(detail.url)}"]`);
    if (button) {
      updateBookmarkButton(button, detail.bookmarked);
    }
  });

  // 既読状態の確認と表示
  document.querySelectorAll('[data-url]').forEach((card) => {
    const url = card.getAttribute('data-url');
    if (!url) return;

    const newIcon = card.querySelector('#new-icon');
    if (newIcon) {
      newIcon.classList.toggle('hidden', isArticleRead(url));
    }
  });

  // カードクリック時の処理
  document.querySelectorAll('[data-url]').forEach((card) => {
    card.addEventListener('click', () => {
      const url = card.getAttribute('data-url');
      if (!url) return;

      saveReadArticle(url);

      // クリック後にカードの見た目を更新
      const newIcon = card.querySelector('#new-icon');
      if (newIcon) {
        newIcon.classList.add('hidden');
      }

      // フィルタを再適用するためのカスタムイベントを発火
      window.dispatchEvent(new CustomEvent('article-read', { detail: { url } }));
    });
  });
</script>
