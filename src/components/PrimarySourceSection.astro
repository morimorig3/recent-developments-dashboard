---
import Card from './Card.astro';
import type { ICard } from '../types';

interface Props {
  label: string;
  articles: ICard[];
}

const { label, articles } = Astro.props;
---

<section class="mb-8 last:mb-0">
  <h3 class="text-base font-bold text-gray-700 dark:text-gray-200 mb-3">
    {label}
  </h3>
  <ul class="grid grid-cols-1 gap-4">
    {
      articles.map(({ title, url, name, createdAt, likesCount, site, category }) => (
        <li>
          <Card
            title={title}
            url={url}
            name={name}
            createdAt={createdAt}
            likesCount={likesCount}
            site={site}
            category={category}
          />
        </li>
      ))
    }
  </ul>
</section>
