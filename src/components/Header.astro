---
const lastUpdated = new Date().toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' });
---

<header class="w-full bg-gray-100 dark:bg-gray-800 px-8 py-2 flex justify-between items-center">
  <div>
    <h1 class="font-bold text-gray-800 dark:text-gray-100">がんばらない技術キャッチアップ</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400">毎日10件だけがんばろう</p>
  </div>
  <div class="flex items-center gap-4">
    <p class="text-gray-500 dark:text-gray-400">最終更新日時: {lastUpdated}</p>
  </div>
</header>
