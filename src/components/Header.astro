---
const lastUpdated = new Date().toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' });
---

<header class="w-full bg-gray-100 dark:bg-gray-800 px-8 py-2 flex justify-between items-center">
  <div>
    <h1 class="font-bold text-gray-800 dark:text-gray-100">がんばらない技術キャッチアップ</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400">毎日10件だけがんばろう</p>
  </div>
  <div class="flex items-center gap-4">
    <button
      id="bookmark-list-btn"
      class="flex items-center gap-1 px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-white text-gray-700 dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors cursor-pointer"
      aria-label="ブックマーク一覧を表示"
    >
      <svg
        class="w-4 h-4 text-yellow-500 dark:text-yellow-400"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
      </svg>
      <span id="bookmark-count">0</span>件
    </button>
    <p class="text-gray-500 dark:text-gray-400 text-sm">最終更新: {lastUpdated}</p>
  </div>
</header>

<!-- ブックマーク一覧モーダル -->
<div
  id="bookmark-modal"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="bookmark-modal-title"
>
  <!-- オーバーレイ -->
  <div id="bookmark-modal-overlay" class="fixed inset-0 bg-black/50"></div>

  <!-- モーダルコンテンツ -->
  <div class="fixed inset-0 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-lg w-full max-h-[80vh] flex flex-col">
      <!-- ヘッダー -->
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 dark:border-gray-700">
        <h2 id="bookmark-modal-title" class="text-lg font-bold text-gray-800 dark:text-gray-100">
          ブックマーク一覧
        </h2>
        <button
          id="bookmark-modal-close"
          class="p-1 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition-colors cursor-pointer"
          aria-label="閉じる"
        >
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- ブックマークリスト -->
      <div id="bookmark-list" class="flex-1 overflow-y-auto p-4">
        <!-- ここにブックマークが動的に追加される -->
      </div>

      <!-- 空の場合のメッセージ -->
      <div id="bookmark-empty" class="hidden p-8 text-center text-gray-500 dark:text-gray-400">
        ブックマークした記事がありません
      </div>
    </div>
  </div>
</div>

<script>
  import { getBookmarks, toggleBookmark } from '../utils/localStorage';

  const bookmarkListBtn = document.getElementById('bookmark-list-btn');
  const bookmarkCountEl = document.getElementById('bookmark-count');
  const bookmarkModal = document.getElementById('bookmark-modal');
  const bookmarkModalOverlay = document.getElementById('bookmark-modal-overlay');
  const bookmarkModalClose = document.getElementById('bookmark-modal-close');
  const bookmarkList = document.getElementById('bookmark-list');
  const bookmarkEmpty = document.getElementById('bookmark-empty');

  // ブックマーク数を更新
  function updateBookmarkCount() {
    const count = getBookmarks().length;
    if (bookmarkCountEl) {
      bookmarkCountEl.textContent = String(count);
    }
  }

  // ブックマークリストを描画
  function renderBookmarkList() {
    if (!bookmarkList || !bookmarkEmpty) return;

    const bookmarks = getBookmarks();

    if (bookmarks.length === 0) {
      bookmarkList.classList.add('hidden');
      bookmarkEmpty.classList.remove('hidden');
      return;
    }

    bookmarkList.classList.remove('hidden');
    bookmarkEmpty.classList.add('hidden');

    // DOM操作でリストを構築（XSS対策）
    bookmarkList.innerHTML = '';
    bookmarks
      .sort((a, b) => new Date(b.bookmarkedAt).getTime() - new Date(a.bookmarkedAt).getTime())
      .forEach((bookmark) => {
        const container = document.createElement('div');
        container.className = 'flex items-center gap-2 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-md mb-2 last:mb-0';

        const link = document.createElement('a');
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.className = 'flex-1 text-sm text-gray-800 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 line-clamp-1 transition-colors';
        link.textContent = bookmark.title;

        const removeBtn = document.createElement('button');
        removeBtn.dataset.removeBookmark = bookmark.url;
        removeBtn.className = 'p-1 text-gray-400 hover:text-red-500 dark:text-gray-500 dark:hover:text-red-400 transition-colors cursor-pointer shrink-0';
        removeBtn.setAttribute('aria-label', 'ブックマークを解除');
        removeBtn.innerHTML = `<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>`;

        removeBtn.addEventListener('click', () => {
          toggleBookmark(bookmark.url, '');
          updateBookmarkCount();
          renderBookmarkList();
          window.dispatchEvent(new CustomEvent('bookmark-changed', { detail: { url: bookmark.url, bookmarked: false } }));
        });

        container.appendChild(link);
        container.appendChild(removeBtn);
        bookmarkList.appendChild(container);
      });
  }

  // モーダルを開く
  function openModal() {
    if (bookmarkModal) {
      renderBookmarkList();
      bookmarkModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  // モーダルを閉じる
  function closeModal() {
    if (bookmarkModal) {
      bookmarkModal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  // イベントリスナーの設定
  bookmarkListBtn?.addEventListener('click', openModal);
  bookmarkModalClose?.addEventListener('click', closeModal);
  bookmarkModalOverlay?.addEventListener('click', closeModal);

  // Escキーでモーダルを閉じる
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && bookmarkModal && !bookmarkModal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // ブックマーク変更時にカウントを更新
  window.addEventListener('bookmark-changed', () => {
    updateBookmarkCount();
  });

  // 初期化
  updateBookmarkCount();
</script>
