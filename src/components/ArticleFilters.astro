---
import FilterButtonGroup from './FilterButtonGroup.astro';
import type { FilterOption } from '../types/filter';

interface Props {
  /** ソースフィルタの選択肢 */
  siteOptions: FilterOption[];
  /** ソースフィルタのラベル (例: 「サイト」) */
  siteLabel: string;
}

const { siteOptions, siteLabel } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-center gap-4">
  <FilterButtonGroup
    label={`${siteLabel}:`}
    dataAttribute="site-filter"
    options={siteOptions}
    ariaLabel={`${siteLabel}フィルタ`}
  />
</div>
