---
export const prerender = true;
import Card from '../components/Card.astro';
import DailySummary from '../components/DailySummary.astro';
import { getItemsFromZenn } from '../services/getItemsFromZenn';
import { getItemsFromQiita } from '../services/getItemsFromQiita';
import { formatZennArticles } from '../functions/formatZennArticles';
import { formatQiitaArticles } from '../functions/formatQiitaArticles';
import { getDailySummary } from '../services/getDailySummary';
import Layout from '../layouts/Layout.astro';

const zennArticles = await getItemsFromZenn(5);
const qiitaArticles = await getItemsFromQiita(5);
const articles = [...formatZennArticles(zennArticles), ...formatQiitaArticles(qiitaArticles)].sort(
  (a, b) => new Date(b.createdAtRaw).getTime() - new Date(a.createdAtRaw).getTime(),
);
const dailySummary = await getDailySummary(articles);
---

<Layout>
  <main class="container mx-auto px-4 py-8">
    <!-- フィルタボタン -->
    <div class="mb-6 flex flex-wrap items-center gap-4">
      <!-- サイトフィルタ -->
      <div class="flex items-center gap-2">
        <span class="text-sm text-gray-600 dark:text-gray-400">サイト:</span>
        <div class="flex gap-1" role="group" aria-label="サイトフィルタ">
          <button
            data-site-filter="all"
            aria-pressed="true"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-gray-800 text-white dark:bg-white dark:text-gray-800 transition-colors"
          >
            すべて
          </button>
          <button
            data-site-filter="qiita"
            aria-pressed="false"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-white text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Qiita
          </button>
          <button
            data-site-filter="zenn"
            aria-pressed="false"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-white text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            Zenn
          </button>
        </div>
      </div>

      <div class="h-6 w-px bg-gray-300 dark:bg-gray-600 hidden sm:block"></div>

      <!-- 既読/未読フィルタ -->
      <div class="flex items-center gap-2">
        <span class="text-sm text-gray-600 dark:text-gray-400">状態:</span>
        <div class="flex gap-1" role="group" aria-label="既読状態フィルタ">
          <button
            data-read-filter="all"
            aria-pressed="true"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-gray-800 text-white dark:bg-white dark:text-gray-800 transition-colors"
          >
            すべて
          </button>
          <button
            data-read-filter="unread"
            aria-pressed="false"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-white text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            未読
          </button>
          <button
            data-read-filter="read"
            aria-pressed="false"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-white text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            既読
          </button>
        </div>
      </div>

      <div class="h-6 w-px bg-gray-300 dark:bg-gray-600 hidden sm:block"></div>

      <!-- ブックマークフィルタ -->
      <div class="flex items-center gap-2">
        <span class="text-sm text-gray-600 dark:text-gray-400">ブックマーク:</span>
        <div class="flex gap-1" role="group" aria-label="ブックマークフィルタ">
          <button
            data-bookmark-filter="all"
            aria-pressed="true"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-gray-800 text-white dark:bg-white dark:text-gray-800 transition-colors"
          >
            すべて
          </button>
          <button
            data-bookmark-filter="bookmarked"
            aria-pressed="false"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-white text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            ブックマーク済み
          </button>
        </div>
      </div>

      <div class="h-6 w-px bg-gray-300 dark:bg-gray-600 hidden sm:block"></div>

      <!-- ソート -->
      <div class="flex items-center gap-2">
        <span class="text-sm text-gray-600 dark:text-gray-400">並び替え:</span>
        <div class="flex gap-1" role="group" aria-label="並び替え">
          <button
            data-sort="date"
            aria-pressed="true"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-gray-800 text-white dark:bg-white dark:text-gray-800 transition-colors"
          >
            新着順
          </button>
          <button
            data-sort="likes"
            aria-pressed="false"
            class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 bg-white text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            いいね数順
          </button>
        </div>
      </div>
    </div>

    <!-- 本日のサマリー -->
    <DailySummary summary={dailySummary} />

    <!-- 記事一覧 -->
    <ul id="article-list" class="grid grid-cols-1 gap-4">
      {
        articles.map(({ title, url, name, createdAt, createdAtRaw, likesCount, site }) => (
          <li data-site={site} data-url={url} data-created-at={createdAtRaw} data-likes-count={likesCount}>
            <Card
              title={title}
              url={url}
              name={name}
              createdAt={createdAt}
              likesCount={likesCount}
              site={site}
            />
          </li>
        ))
      }
    </ul>

    <!-- フィルタ結果が0件の場合 -->
    <p id="no-results" class="hidden text-center text-gray-500 dark:text-gray-400 py-8">
      該当する記事がありません
    </p>
  </main>
</Layout>

<script>
  import { cleanupOldArticles, isArticleRead, isBookmarked } from '../utils/localStorage';

  // ページ読み込み時に1度だけ古い既読情報を削除
  cleanupOldArticles();

  // フィルタ・ソート状態の型定義
  type ArticleSite = 'qiita' | 'zenn';
  type SiteFilter = 'all' | ArticleSite;
  type ReadFilter = 'all' | 'unread' | 'read';
  type BookmarkFilter = 'all' | 'bookmarked';
  type SortOption = 'date' | 'likes';

  let currentSiteFilter: SiteFilter = 'all';
  let currentReadFilter: ReadFilter = 'all';
  let currentBookmarkFilter: BookmarkFilter = 'all';
  let currentSort: SortOption = 'date';

  const articleList = document.getElementById('article-list');
  const noResults = document.getElementById('no-results');
  const siteFilterButtons = document.querySelectorAll<HTMLButtonElement>('[data-site-filter]');
  const readFilterButtons = document.querySelectorAll<HTMLButtonElement>('[data-read-filter]');
  const bookmarkFilterButtons = document.querySelectorAll<HTMLButtonElement>('[data-bookmark-filter]');
  const sortButtons = document.querySelectorAll<HTMLButtonElement>('[data-sort]');

  // アクティブなボタンのスタイルを適用
  const activeClass = 'bg-gray-800 text-white dark:bg-white dark:text-gray-800';
  const inactiveClass =
    'bg-white text-gray-700 dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700';

  function updateButtonStyles(
    buttons: NodeListOf<HTMLButtonElement>,
    activeValue: string,
    dataAttr: 'siteFilter' | 'readFilter' | 'sort' | 'bookmarkFilter'
  ) {
    buttons.forEach((btn) => {
      const value = btn.dataset[dataAttr];
      const isActive = value === activeValue;

      // クラスをリセットして適用
      activeClass.split(' ').forEach((c) => btn.classList.toggle(c, isActive));
      inactiveClass.split(' ').forEach((c) => btn.classList.toggle(c, !isActive));

      // aria-pressed属性を更新
      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
  }

  function applyFilters() {
    if (!articleList || !noResults) return;

    const items = articleList.querySelectorAll<HTMLLIElement>('li[data-site]');
    let visibleCount = 0;

    items.forEach((item) => {
      const site = item.dataset.site as ArticleSite;
      const url = item.dataset.url || '';
      const isRead = isArticleRead(url);
      const bookmarked = isBookmarked(url);

      // サイトフィルタのチェック
      const siteMatch = currentSiteFilter === 'all' || site === currentSiteFilter;

      // 既読/未読フィルタのチェック
      const readMatch =
        currentReadFilter === 'all' ||
        (currentReadFilter === 'unread' && !isRead) ||
        (currentReadFilter === 'read' && isRead);

      // ブックマークフィルタのチェック
      const bookmarkMatch = currentBookmarkFilter === 'all' || bookmarked;

      const isVisible = siteMatch && readMatch && bookmarkMatch;
      item.classList.toggle('hidden', !isVisible);

      if (isVisible) visibleCount++;
    });

    // 0件メッセージの表示/非表示
    noResults.classList.toggle('hidden', visibleCount > 0);
  }

  // フィルタ値のバリデーション
  function isValidSiteFilter(value: string | undefined): value is SiteFilter {
    return value === 'all' || value === 'qiita' || value === 'zenn';
  }

  function isValidReadFilter(value: string | undefined): value is ReadFilter {
    return value === 'all' || value === 'unread' || value === 'read';
  }

  function isValidSortOption(value: string | undefined): value is SortOption {
    return value === 'date' || value === 'likes';
  }

  function isValidBookmarkFilter(value: string | undefined): value is BookmarkFilter {
    return value === 'all' || value === 'bookmarked';
  }

  function applySort() {
    if (!articleList) return;

    const items = Array.from(articleList.querySelectorAll<HTMLLIElement>('li[data-site]'));

    items.sort((a, b) => {
      if (currentSort === 'date') {
        const dateA = new Date(a.dataset.createdAt || '').getTime() || 0;
        const dateB = new Date(b.dataset.createdAt || '').getTime() || 0;
        return dateB - dateA;
      } else {
        const likesA = parseInt(a.dataset.likesCount || '0', 10);
        const likesB = parseInt(b.dataset.likesCount || '0', 10);
        return likesB - likesA;
      }
    });

    items.forEach((item) => articleList.appendChild(item));
  }

  // サイトフィルタボタンのイベント
  siteFilterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const value = btn.dataset.siteFilter;
      if (isValidSiteFilter(value)) {
        currentSiteFilter = value;
        updateButtonStyles(siteFilterButtons, currentSiteFilter, 'siteFilter');
        applyFilters();
      }
    });
  });

  // 既読/未読フィルタボタンのイベント
  readFilterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const value = btn.dataset.readFilter;
      if (isValidReadFilter(value)) {
        currentReadFilter = value;
        updateButtonStyles(readFilterButtons, currentReadFilter, 'readFilter');
        applyFilters();
      }
    });
  });

  // ブックマークフィルタボタンのイベント
  bookmarkFilterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const value = btn.dataset.bookmarkFilter;
      if (isValidBookmarkFilter(value)) {
        currentBookmarkFilter = value;
        updateButtonStyles(bookmarkFilterButtons, currentBookmarkFilter, 'bookmarkFilter');
        applyFilters();
      }
    });
  });

  // ソートボタンのイベント
  sortButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const value = btn.dataset.sort;
      if (isValidSortOption(value)) {
        currentSort = value;
        updateButtonStyles(sortButtons, currentSort, 'sort');
        applySort();
      }
    });
  });

  // 記事クリック時にフィルタを再適用（既読状態が変わるため）
  window.addEventListener('article-read', () => applyFilters());

  // ブックマーク変更時にフィルタを再適用
  window.addEventListener('bookmark-changed', () => applyFilters());

  // 初期状態でフィルタを適用（既読状態を反映）
  applyFilters();
</script>
