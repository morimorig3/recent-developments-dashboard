---
export const prerender = true;
import DailySummary from '../components/DailySummary.astro';
import ArticlePanel from '../components/ArticlePanel.astro';
import TabSwitcher from '../components/TabSwitcher.astro';
import SourceList from '../components/SourceList.astro';
import PrimarySourceSection from '../components/PrimarySourceSection.astro';
import { getItemsFromZenn } from '../services/getItemsFromZenn';
import { getItemsFromQiita } from '../services/getItemsFromQiita';
import { getItemsFromHatena } from '../services/getItemsFromHatena';
import { getItemsFromFeed } from '../services/getItemsFromFeed';
import { formatZennArticles } from '../functions/formatZennArticles';
import { formatQiitaArticles } from '../functions/formatQiitaArticles';
import { formatHatenaArticles } from '../functions/formatHatenaArticles';
import { formatFeedArticles } from '../functions/formatFeedArticles';
import { dedupeArticles } from '../functions/dedupeArticles';
import { groupArticlesBySource } from '../functions/groupArticlesBySource';
import { getDailySummary } from '../services/getDailySummary';
import { PRIMARY_SOURCE_MAX_ITEMS, PRIMARY_SOURCES } from '../config/primarySources';
import type { ICard } from '../types';
import Layout from '../layouts/Layout.astro';
import LayersIcon from '../assets/layers.svg';
import RssIcon from '../assets/rss.svg';

const [zennArticles, qiitaArticles, hatenaArticles, ...primaryResults] = await Promise.all([
  getItemsFromZenn(5),
  getItemsFromQiita(5),
  getItemsFromHatena(5),
  ...PRIMARY_SOURCES.map((source) => getItemsFromFeed(source)),
]);

const byDateDesc = (a: ICard, b: ICard) =>
  new Date(b.createdAtRaw).getTime() - new Date(a.createdAtRaw).getTime();

// キュレーション記事（Hatenaに載ったQiita/Zenn記事の重複をここで排除）
const curatedArticles = dedupeArticles([
  ...formatZennArticles(zennArticles),
  ...formatQiitaArticles(qiitaArticles),
  ...formatHatenaArticles(hatenaArticles),
]).sort(byDateDesc);

// 公式情報（web.dev と Chrome Developers の重複をここで排除）
// 全体の上限は設けず、ソースごとにセクション分けして表示する
const primaryArticles = dedupeArticles(
  primaryResults.flatMap((items, index) => formatFeedArticles(items, PRIMARY_SOURCES[index])),
);
const primaryGroups = groupArticlesBySource(primaryArticles);

// サマリーの入力はキュレーション記事のみ
const dailySummary = await getDailySummary(curatedArticles);

const curatedSiteOptions = [
  { value: 'all', label: 'すべて', isDefault: true },
  { value: 'qiita', label: 'Qiita' },
  { value: 'zenn', label: 'Zenn' },
  { value: 'hatena', label: 'Hatena' },
];
---

<Layout>
  <main class="container mx-auto px-4 py-8">
    <TabSwitcher
      tabs={[
        { id: 'curated', label: 'キュレーション記事', count: curatedArticles.length, icon: LayersIcon },
        { id: 'primary', label: '公式情報', count: primaryArticles.length, icon: RssIcon },
      ]}
    />

    <ArticlePanel
      panelId="curated"
      articles={curatedArticles}
      siteOptions={curatedSiteOptions}
      siteLabel="サイト"
    >
      <!-- 本日のサマリー -->
      <DailySummary summary={dailySummary} />
    </ArticlePanel>

    <ArticlePanel panelId="primary" hidden>
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-6">
        各媒体の最新記事を{PRIMARY_SOURCE_MAX_ITEMS}件ずつ、媒体ごとにまとめて表示しています。
      </p>
      {primaryGroups.map((group) => <PrimarySourceSection label={group.label} articles={group.articles} />)}
    </ArticlePanel>

    <SourceList />
  </main>
</Layout>
